<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/kindred_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/kindred_widget_bg"
  android:gravity="center_vertical"
  android:orientation="vertical"
  android:padding="10dp">
  <TextView
    android:id="@+id/kindred_widget_title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="6dp"
    android:paddingBottom="2dp"
    android:text="How's today?"
    android:textColor="#26231F"
    android:textSize="13sp"
    android:textStyle="bold" />
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <LinearLayout
      android:id="@+id/kindred_mood_5"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:gravity="center"
      android:orientation="vertical"
      android:paddingTop="4dp"
      android:paddingBottom="4dp"
      android:background="?android:attr/selectableItemBackground"
      android:contentDescription="Great">
      <ImageView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:importantForAccessibility="no"
        android:src="@drawable/kindred_face_5" />
      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Great"
        android:textSize="11sp" android:textColor="#8A847B" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/kindred_mood_4"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:gravity="center"
      android:orientation="vertical"
      android:paddingTop="4dp"
      android:paddingBottom="4dp"
      android:background="?android:attr/selectableItemBackground"
      android:contentDescription="Good">
      <ImageView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:importantForAccessibility="no"
        android:src="@drawable/kindred_face_4" />
      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Good"
        android:textSize="11sp" android:textColor="#8A847B" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/kindred_mood_3"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:gravity="center"
      android:orientation="vertical"
      android:paddingTop="4dp"
      android:paddingBottom="4dp"
      android:background="?android:attr/selectableItemBackground"
      android:contentDescription="Okay">
      <ImageView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:importantForAccessibility="no"
        android:src="@drawable/kindred_face_3" />
      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Okay"
        android:textSize="11sp" android:textColor="#8A847B" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/kindred_mood_2"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:gravity="center"
      android:orientation="vertical"
      android:paddingTop="4dp"
      android:paddingBottom="4dp"
      android:background="?android:attr/selectableItemBackground"
      android:contentDescription="Bad">
      <ImageView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:importantForAccessibility="no"
        android:src="@drawable/kindred_face_2" />
      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bad"
        android:textSize="11sp" android:textColor="#8A847B" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/kindred_mood_1"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:gravity="center"
      android:orientation="vertical"
      android:paddingTop="4dp"
      android:paddingBottom="4dp"
      android:background="?android:attr/selectableItemBackground"
      android:contentDescription="Awful">
      <ImageView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:importantForAccessibility="no"
        android:src="@drawable/kindred_face_1" />
      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Awful"
        android:textSize="11sp" android:textColor="#8A847B" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
